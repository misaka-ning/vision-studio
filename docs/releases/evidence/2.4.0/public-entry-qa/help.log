  --evaluation-request <path>     评估自检 JSON 请求文件（需配合 --smoke-evaluation）
  --conversion-source <path>      转换自检的本地 PT 模型
  --conversion-format <format>    转换自检格式：onnx 或 torchscript
  --display-model <path>          指定结构显示的模型文件
  --device <mode>                 推理设备：auto、cpu 或 cuda
  --gpu-index <index>             NVIDIA GPU 索引（默认 0）
